rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function isConversationParticipant(conversationId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role != 'admin' && !request.resource.data.keys().hasAny(['isPremium', 'premium', 'plan']);
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role && request.resource.data.uid == resource.data.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'premium', 'plan']));
      allow delete: if isAdmin();
    }

    match /athletes/{athleteId} {
      allow get: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || athleteId == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || athleteId == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || athleteId == request.auth.uid) && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /publicAthletes/{athleteId} {
      allow get, list: if resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /searches/{searchId} {
      allow get: if isAuthenticated() || isAdmin();
      allow list: if isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.clubId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (isAuthenticated() && resource.data.clubId == request.auth.uid && request.resource.data.clubId == resource.data.clubId);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.clubId == request.auth.uid);
    }

    match /publicSearches/{searchId} {
      allow get, list: if resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow get: if isAdmin() || (isAuthenticated() && (resource.data.athleteId == request.auth.uid || resource.data.clubId == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.athleteId == request.auth.uid && request.resource.data.clubId != request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated() && resource.data.athleteId == request.auth.uid && request.resource.data.athleteId == resource.data.athleteId && request.resource.data.clubId == resource.data.clubId);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.athleteId == request.auth.uid);
    }

    match /teams/{teamId} {
      allow get: if isAuthenticated() || isAdmin();
      allow list: if isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.ownerUserId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (isAuthenticated() && resource.data.ownerUserId == request.auth.uid && request.resource.data.ownerUserId == resource.data.ownerUserId);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.ownerUserId == request.auth.uid);
    }

    match /publicTeams/{teamId} {
      allow get, list: if resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow get: if isAuthenticated() || isAdmin();
      allow list: if isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.organizerUserId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (isAuthenticated() && resource.data.organizerUserId == request.auth.uid && request.resource.data.organizerUserId == resource.data.organizerUserId);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.organizerUserId == request.auth.uid);
    }

    match /publicTournaments/{tournamentId} {
      allow get, list: if resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow get: if isAdmin() || isConversationParticipant(conversationId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid in request.resource.data.participants);
      allow update: if isAdmin() || (isConversationParticipant(conversationId) && request.resource.data.participants == resource.data.participants);
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow get, list: if isAdmin() || isConversationParticipant(conversationId);
        allow create: if isAdmin() || (isConversationParticipant(conversationId) && request.resource.data.senderId == request.auth.uid);
        allow update, delete: if isAdmin() || (isConversationParticipant(conversationId) && resource.data.senderId == request.auth.uid && request.resource.data.senderId == resource.data.senderId);
      }
    }

    match /notifications/{notificationId} {
      allow get: if isAdmin() || (isAuthenticated() && resource.data.recipientUserId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.recipientUserId == request.auth.uid && request.resource.data.recipientUserId == resource.data.recipientUserId);
    }

    match /userReviews/{reviewId} {
      allow get, list: if true;
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.authorUserId == request.auth.uid);
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.authorUserId == request.auth.uid && request.resource.data.authorUserId == resource.data.authorUserId);
    }

    match /verifiedReferences/{referenceId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /careerTimelines/{timelineId} {
      allow get, list: if true;
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId);
    }

    match /verifications/{verificationId} {
      allow get: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /verificationRequests/{requestId} {
      allow get: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.reporterUserId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /userReports/{reportId} {
      allow get: if isAdmin() || (isAuthenticated() && resource.data.reporterUserId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.reporterUserId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /fraudAlerts/{alertId} { allow read, write: if isAdmin(); }
    match /moderationAuditLogs/{logId} { allow read, write: if isAdmin(); }

    match /accountAppeals/{appealId} {
      allow get: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /aiUsageDaily/{usageId} { allow read, write: if false; }
    match /mercadopagoWebhookEvents/{eventId} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}