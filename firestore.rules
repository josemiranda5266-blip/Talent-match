rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isConversationParticipant(conversationId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // User accounts: private by default. Public discovery must use a dedicated
    // public profile projection, not the canonical user document.
    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.role != 'admin';
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }

    // Athlete records can only be accessed by the owner or an administrator.
    // Public scouting/search results should be served from a sanitized public
    // collection or an authorized backend endpoint.
    match /athletes/{athleteId} {
      allow get: if isAdmin() ||
        (isAuthenticated() &&
          (resource.data.userId == request.auth.uid || athleteId == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || athleteId == request.auth.uid);
      allow update: if isAdmin() ||
        (isAuthenticated() &&
          (resource.data.userId == request.auth.uid || athleteId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Club searches/conventions can be publicly discoverable only through a
    // sanitized projection/API. Direct Firestore access is restricted.
    match /searches/{searchId} {
      allow get: if isAuthenticated() || isAdmin();
      allow list: if isAdmin();
      allow create: if isAuthenticated() &&
        (request.resource.data.clubId == request.auth.uid || isAdmin());
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.clubId == request.auth.uid);
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.clubId == request.auth.uid);
    }

    // Applications are private. In particular, authenticated users must not
    // be able to list every application in the system.
    match /applications/{applicationId} {
      allow get: if isAdmin() ||
        (isAuthenticated() &&
          (resource.data.athleteId == request.auth.uid || resource.data.clubId == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.athleteId == request.auth.uid);
      allow update: if isAdmin() ||
        (isAuthenticated() &&
          (resource.data.athleteId == request.auth.uid || resource.data.clubId == request.auth.uid));
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.athleteId == request.auth.uid);
    }

    match /teams/{teamId} {
      allow get: if isAuthenticated() || isAdmin();
      allow list: if isAdmin();
      allow create: if isAuthenticated() &&
        (request.resource.data.ownerUserId == request.auth.uid || isAdmin());
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.ownerUserId == request.auth.uid);
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.ownerUserId == request.auth.uid);
    }

    match /tournaments/{tournamentId} {
      allow get: if isAuthenticated() || isAdmin();
      allow list: if isAdmin();
      allow create: if isAuthenticated() &&
        (request.resource.data.organizerUserId == request.auth.uid || isAdmin());
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.organizerUserId == request.auth.uid);
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.organizerUserId == request.auth.uid);
    }

    // Conversations and messages: participants only.
    match /conversations/{conversationId} {
      allow get: if isAdmin() || isConversationParticipant(conversationId);
      allow list: if isAdmin();
      allow create: if isAdmin() ||
        (isAuthenticated() && request.auth.uid in request.resource.data.participants);
      allow update: if isAdmin() || isConversationParticipant(conversationId);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isAdmin() || isConversationParticipant(conversationId);
        allow create: if isAdmin() ||
          (isConversationParticipant(conversationId) &&
            request.resource.data.senderId == request.auth.uid);
        allow update, delete: if isAdmin() ||
          (isConversationParticipant(conversationId) &&
            resource.data.senderId == request.auth.uid);
      }
    }

    // Notifications are private and must not be forgeable by arbitrary users.
    // Creation should normally happen server-side with Admin SDK.
    match /notifications/{notificationId} {
      allow get: if isAdmin() ||
        (isAuthenticated() && resource.data.recipientUserId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() ||
        (isAuthenticated() && resource.data.recipientUserId == request.auth.uid);
    }

    // Reviews are public-facing content, but creation must be tied to the author.
    match /userReviews/{reviewId} {
      allow get, list: if true;
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.authorUserId == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isAuthenticated() && resource.data.authorUserId == request.auth.uid);
    }

    // Verified references must be moderated/server-created.
    match /verifiedReferences/{referenceId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /careerTimelines/{timelineId} {
      allow get, list: if true;
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Identity/accreditation data is private.
    match /verifications/{verificationId} {
      allow get: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /verificationRequests/{requestId} {
      allow get: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Reports, fraud alerts and moderation logs are administrative/private.
    match /reports/{reportId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.reporterUserId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /userReports/{reportId} {
      allow get: if isAdmin() ||
        (isAuthenticated() && resource.data.reporterUserId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.reporterUserId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /fraudAlerts/{alertId} {
      allow read, write: if isAdmin();
    }

    match /moderationAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /accountAppeals/{appealId} {
      allow get: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Default deny: new collections are private until explicitly reviewed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
