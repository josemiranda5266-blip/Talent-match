rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(userId) && (request.resource.data.role != 'admin' || isAdmin());
      allow update: if isAdmin() || (isOwner(userId) && (request.resource.data.role == resource.data.role || (!isAdmin() && request.resource.data.role != 'admin')));
      allow delete: if isAdmin();
    }

    // Athletes Collection
    match /athletes/{athleteId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || athleteId == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || athleteId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Searches Collection (Convocatorias de Clubes)
    match /searches/{searchId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.clubId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.clubId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.clubId == request.auth.uid);
    }

    // Applications Collection
    match /applications/{applicationId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && (resource.data.athleteId == request.auth.uid || resource.data.clubId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.athleteId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.athleteId == request.auth.uid || resource.data.clubId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.athleteId == request.auth.uid);
    }

    // Teams / Directory Collection
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.ownerUserId == request.auth.uid || resource.data.id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Tournaments Collection
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.organizerUserId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Conversations & Messages
    match /conversations/{conversationId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin());
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId;
        allow update, delete: if isAdmin();
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && (resource.data.recipientUserId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.recipientUserId == request.auth.uid || isAdmin());
    }

    // Reviews & Ratings (UserReviews)
    match /userReviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.authorUserId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.authorUserId == request.auth.uid);
    }

    // Verified References (Club & Trainer references)
    match /verifiedReferences/{referenceId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Career Timelines
    match /careerTimelines/{timelineId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Verifications (Identity & Accreditation Requests)
    match /verifications/{verificationId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /verificationRequests/{requestId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Reports & Moderation
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.reporterUserId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /userReports/{reportId} {
      allow list: if isAuthenticated();
      allow get: if isAdmin() || (isAuthenticated() && resource.data.reporterUserId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.reporterUserId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Fraud Alerts (Anti-Spam & Trust)
    match /fraudAlerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // Moderation Audit Logs
    match /moderationAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Account Appeals
    match /accountAppeals/{appealId} {
      allow list: if isAuthenticated();
      allow get: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
