{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User accounts with roles (admin, club, athlete, scout) and profile metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "club", "athlete", "scout"] },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["none", "pending", "verified", "rejected"] },
        "isPremium": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "athletes": {
      "title": "Athletes",
      "description": "Detailed sports profiles for athletes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "sport": { "type": "string" },
        "position": { "type": "string" },
        "age": { "type": "number" },
        "heightCm": { "type": "number" },
        "weightKg": { "type": "number" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "level": { "type": "string" },
        "preferredFootOrHand": { "type": "string" },
        "bio": { "type": "string" },
        "sportsExperience": { "type": "string" },
        "galleryPhotos": { "type": "array", "items": { "type": "string" } },
        "videoUrl": { "type": "string" },
        "availableForTrials": { "type": "boolean" },
        "isPremium": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" }
      },
      "required": ["id", "name", "sport", "position", "city", "province"]
    },
    "searches": {
      "title": "Club Searches",
      "description": "Scouting calls and tryout notices created by clubs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clubId": { "type": "string" },
        "clubName": { "type": "string" },
        "clubLogo": { "type": "string" },
        "title": { "type": "string" },
        "sport": { "type": "string" },
        "positionNeeded": { "type": "string" },
        "minAge": { "type": "number" },
        "maxAge": { "type": "number" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "levelRequired": { "type": "string" },
        "trialDate": { "type": "string" },
        "trialTime": { "type": "string" },
        "locationDetails": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Abierta", "Cerrada", "En Pruebas"] },
        "postedAt": { "type": "string" },
        "applicantCount": { "type": "number" }
      },
      "required": ["id", "clubName", "title", "sport", "city", "province"]
    },
    "applications": {
      "title": "Search Applications",
      "description": "Applications submitted by athletes to club searches.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "searchId": { "type": "string" },
        "athleteId": { "type": "string" },
        "athleteName": { "type": "string" },
        "athleteAvatar": { "type": "string" },
        "clubId": { "type": "string" },
        "appliedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["Pendiente", "Preseleccionado", "Citado a Prueba", "Descartado"] },
        "noteFromAthlete": { "type": "string" }
      },
      "required": ["id", "searchId", "athleteId", "status"]
    },
    "teams": {
      "title": "Teams / Clubs Directory",
      "description": "Sports clubs, academies, and grassroots teams.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUserId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "sport": { "type": "string" },
        "logoUrl": { "type": "string" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "address": { "type": "string" },
        "description": { "type": "string" },
        "contactWhatsApp": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "sport", "city", "province"]
    },
    "tournaments": {
      "title": "Tournaments",
      "description": "Tournaments, cups, and regional leagues.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizerUserId": { "type": "string" },
        "title": { "type": "string" },
        "organizerName": { "type": "string" },
        "sport": { "type": "string" },
        "category": { "type": "string" },
        "province": { "type": "string" },
        "city": { "type": "string" },
        "venueName": { "type": "string" },
        "startDate": { "type": "string" },
        "description": { "type": "string" },
        "contactWhatsApp": { "type": "string" },
        "bannerImage": { "type": "string" },
        "isVerifiedOrganizer": { "type": "boolean" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "organizerName", "sport", "city", "province"]
    },
    "conversations": {
      "title": "Conversations",
      "description": "Private messaging channels between users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "participantDetails": { "type": "object" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participants"]
    },
    "notifications": {
      "title": "Notifications",
      "description": "Real-time user notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientUserId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "recipientUserId", "title", "message"]
    },
    "reviews": {
      "title": "Reviews and Ratings",
      "description": "Reputation reviews for athletes, clubs, or scouts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetId": { "type": "string" },
        "authorUserId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "targetId", "authorUserId", "rating", "comment"]
    },
    "verifications": {
      "title": "Verification Requests",
      "description": "Identity and club accreditation verification requests submitted to admins.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "documentType": { "type": "string" },
        "documentUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "documentUrl", "status"]
    },
    "reports": {
      "title": "User Reports / Complaints",
      "description": "Community complaints or flagged content submitted to admins.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterUserId": { "type": "string" },
        "targetType": { "type": "string", "enum": ["user", "post", "tournament"] },
        "targetId": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reporterUserId", "targetId", "reason", "status"]
    }
  }
}
